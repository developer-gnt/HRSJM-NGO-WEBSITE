# ===================================================================
# ENVIRONMENT SELECTION
# Set to 'local' for local development or 'production' for VPS
# ===================================================================
NEXT_PUBLIC_APP_ENV=local

# ===================================================================
# BACKEND API URLS
# Auto-selected by NEXT_PUBLIC_APP_ENV, or uncomment below to override:
# ===================================================================
# --- LOCAL BACKEND ---
BACKEND_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# --- PRODUCTION BACKEND (VPS 194.164.151.17:3000) ---
# BACKEND_API_URL=http://194.164.151.17:3000/api/v1
# NEXT_PUBLIC_API_URL=http://194.164.151.17:3000/api/v1

# ===================================================================
# PAYMENT GATEWAY MODE (sandbox / production)
# ===================================================================
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# ===================================================================
# APPLICATION PORT
# ===================================================================
PORT=3001

