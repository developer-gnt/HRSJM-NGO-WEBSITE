# ===================================================================
# ENVIRONMENT SELECTION
# Set to 'local' for local development or 'production' for VPS
# ===================================================================
NEXT_PUBLIC_APP_ENV=production

# ===================================================================
# BACKEND API URLS
# Auto-selected by NEXT_PUBLIC_APP_ENV, or uncomment below to override:
# ===================================================================
# --- LOCAL BACKEND ---
# BACKEND_API_URL=http://localhost:3000/api/v1
# NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# --- PRODUCTION BACKEND ---
BACKEND_API_URL=https://hrsjm.org/api/v1
NEXT_PUBLIC_API_URL=https://hrsjm.org/api/v1

# ===================================================================
# PAYMENT GATEWAY MODE (sandbox / production)
# ===================================================================
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# ===================================================================
# APPLICATION PORT
# ===================================================================
PORT=3001

# ===================================================================
# SMTP MAIL CONFIGURATION
# ===================================================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=enquiry@hrsjm.org
SMTP_PASS=Hrsjm@2012
MAIL_FROM=enquiry@hrsjm.org
ADMIN_NOTIFICATION_EMAIL=president.hrsjm@gmail.com
PRESIDENT_EMAIL=president.hrsjm@gmail.com
PASSWORD_RESET_BASE_URL=https://webapp.hrsjm.org
